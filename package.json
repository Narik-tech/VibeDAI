{
  "name": "vibe-d-ai",
  "version": "0.1.0",
  "private": true,
  "description": "A local full-turn search engine and analysis workbench for 5D Chess with Multiverse Time Travel",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.js",
    "analyze": "node src/cli.js",
    "test": "node --test",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:classical": "node scripts/benchmark-classical.js",
    "benchmark:checkmate": "node scripts/benchmark-checkmate.js",
    "benchmark:parallel": "node scripts/benchmark-parallel.js",
    "benchmark:transformer": "node scripts/benchmark-transformer.js",
    "strength": "node scripts/strength.js",
    "match": "node scripts/match.js",
    "selfplay": "node scripts/selfplay.js",
    "transformer:setup": "node scripts/transformer.js setup",
    "transformer:doctor": "node scripts/transformer.js doctor",
    "transformer:data": "node scripts/transformer-data.js",
    "transformer:train": "node scripts/transformer.js train",
    "transformer:evaluate": "node scripts/transformer.js evaluate",
    "transformer:selfplay": "node scripts/transformer-selfplay.js",
    "transformer:selfplay:continuous": "node scripts/transformer-selfplay.js --iterations 0",
    "transformer:test": "node scripts/transformer.js test",
    "transformer:smoke": "node scripts/transformer-smoke.js",
    "lc0:inspect": "node scripts/lc0.js inspect",
    "lc0:data": "node scripts/lc0.js data",
    "lc0:train": "node scripts/lc0.js train",
    "lc0:evaluate": "node scripts/lc0.js evaluate",
    "lc0:test": "node scripts/lc0.js test",
    "lc0:smoke": "node scripts/lc0-smoke.js"
  },
  "dependencies": { "5d-chess-js": "1.2.1" }
}
